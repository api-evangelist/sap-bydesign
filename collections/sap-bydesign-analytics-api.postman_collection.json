        {
          "id": "9d2076e8-a117-4a97-a160-7378a589cc01",
          "name": "Query Business Analytics report",
          "request": {
            "name": "Query Business Analytics report",
            "description": {
              "content": "Query data from a Business Analytics report entity set. Filter by characteristics such as posting date, fiscal period, and report-specific selection parameters. Supports $select for choosing characteristics and key figures, and $filter for restricting result rows.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sap",
                "byd",
                "odata",
                "ana_businessanalytics_analytics.svc",
                ":ReportEntitySet"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$filter",
                  "value": "<string>",
                  "description": "OData filter expression (e.g., Status eq 'Released' and PostingDate ge datetime'2024-01-01T00:00:00')."
                },
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Comma-separated list of properties to include in the response."
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "20",
                  "description": "Maximum number of records to return."
                },
                {
                  "disabled": false,
                  "key": "$skip",
                  "value": "0",
                  "description": "Number of records to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "$format",
                  "value": "json",
                  "description": "Response format. Use 'json' for JSON output."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ReportEntitySet",
                  "description": "(Required) The report entity set identifier (e.g., RP{ReportID}QueryResults)."
                },
                {
                  "description": "Your SAP Business ByDesign tenant hostname",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "header": [
